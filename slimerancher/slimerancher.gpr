with "config/slimerancher_config.gpr";
project Slimerancher is

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Slimerancher_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("slimerancher.adb");

   package Compiler is
      for Default_Switches ("Ada") use Slimerancher_Config.Ada_Compiler_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Slimerancher;
